<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications (FCM/APNs) — development; Xcode ganti ke release saat build App Store. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- App Group bersama widget extension (SagansaWidget) untuk share token & cache. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.id.sagansa.app</string>
	</array>
</dict>
</plist>
